# --- Required everywhere ---
BOT_TOKEN=123456:ABC-DEF-your-bot-token-from-BotFather
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DB_NAME=digital_equb
ADMIN_IDS=111111111,222222222

# Currency label shown next to amounts, e.g. ETB, USD, KES.
DEFAULT_CURRENCY=ETB

# --- Webhook mode only (Docker / Render / Railway / Fly / gunicorn / Vercel) ---
WEBHOOK_SECRET=some-long-random-string
WEBHOOK_PATH=/webhook

# Public base URL of THIS deployment (no trailing slash), used to
# auto-register the webhook on startup in webhook mode.
# e.g. https://your-app.onrender.com  or  https://your-app.up.railway.app
# Not used in polling mode. Not used by api/webhook.py on Vercel (that one
# has no startup hook -- register it once with `python set_webhook.py`
# after setting WEBHOOK_URL below).
PUBLIC_URL=

# Only needed for the one-off set_webhook.py script (Vercel deployments).
WEBHOOK_URL=https://your-app.vercel.app/api/webhook

# --- Deployment mode selection (optional) ---
# "polling" or "webhook". If omitted, it's auto-detected: webhook if PORT
# is set (most PaaS web services set this automatically), polling otherwise.
RUN_MODE=

# Port the webhook server binds to (most platforms set this for you).
PORT=8080

# Optional Telegram message-effect id applied to payout announcements.
PAYOUT_MESSAGE_EFFECT_ID=5298766204649872471

# --- Lottery draw scheduling ---
# IANA timezone used to DISPLAY draw dates/times (default: Ethiopian time).
# All times are stored in UTC internally; this only affects what members see.
TIMEZONE=Africa/Addis_Ababa

# How often (seconds) the background scheduler checks for due draws
# (long-running deployments only; serverless runs draws lazily on traffic).
SCHEDULER_INTERVAL_SECONDS=30

# Minutes before each draw to remind admins about proofs still awaiting
# review (unverified members are excluded from that round's draw).
ADMIN_PRE_DRAW_REMIND_MINUTES=60

# Default hours /postpone moves a pending draw when called without args.
DRAW_POSTPONE_HOURS=24
