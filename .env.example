# =============================================================================
# Digital Equb bot — environment variables
# Copy to .env for local runs (python-dotenv loads it automatically).
# =============================================================================

# --- Required everywhere ---
BOT_TOKEN=123456:ABC-DEF-your-bot-token-from-BotFather
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DB_NAME=digital_equb

# How long (ms) to wait for Mongo before failing startup / a query.
MONGO_TIMEOUT_MS=20000

# Comma-separated Telegram user ids seeded as bot admins on startup
# (also stored in the DB; manage later with /addadmin /deladmin).
ADMIN_IDS=111111111,222222222

# Default currency label when /newequb omits one (e.g. ETB, USD, KES).
DEFAULT_CURRENCY=ETB

# --- Webhook mode (Docker / Render / Railway / Fly / gunicorn / Vercel) ---
# Shared secret: Telegram sends it on webhook POSTs; also used to protect
# /run-draws and /register_webhook.
WEBHOOK_SECRET=some-long-random-string
WEBHOOK_PATH=/webhook

# Public base URL of THIS deployment (no trailing slash). When set, the
# long-running server auto-registers the webhook with Telegram on startup.
# Example: https://your-app.onrender.com
# Not used in polling mode. Not used by api/webhook.py on Vercel (register
# once with: python set_webhook.py after setting WEBHOOK_URL below).
PUBLIC_URL=

# Only needed for the one-off set_webhook.py script (Vercel, etc.).
WEBHOOK_URL=https://your-app.vercel.app/api/webhook

# --- Deployment mode ---
# "polling" or "webhook". If omitted: webhook when PORT is set (typical PaaS),
# otherwise polling.
RUN_MODE=

# Port the HTTP server binds to (PaaS usually injects this).
PORT=8080

# Optional: numeric effect id for winner PRIVATE DMs only (draw + paid).
# Empty disables. Groups do not show effects reliably (Bot API).
PAYOUT_MESSAGE_EFFECT_ID=5159385139981059269

# --- Draw scheduling ---
# IANA timezone for DISPLAY only (stored times are UTC). Default: Ethiopia.
TIMEZONE=Africa/Addis_Ababa

# How often (seconds) the background scheduler checks for due draws
# (long-running deployments only).
SCHEDULER_INTERVAL_SECONDS=30

# Serverless (Vercel) has no background loop. Point an external cron at:
#   Long-running:  GET/POST /run-draws
#                  Header: X-Webhook-Secret: $WEBHOOK_SECRET
#   Vercel:        GET/POST /api/webhook?run_draws=1&secret=$WEBHOOK_SECRET
# Every 1–5 minutes is enough; atomic DB claims prevent double draws.

# Minutes before each draw to DM admins about proofs still awaiting review.
ADMIN_PRE_DRAW_REMIND_MINUTES=60

# Default hours /postpone moves a pending draw when called with no argument.
DRAW_POSTPONE_HOURS=24
